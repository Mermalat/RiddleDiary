    "test": "node scripts/test.mjs",
    "install:vault": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3"
  }
}
